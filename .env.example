# AirRadar environment variables (copy to .env for local docker run; never commit real keys)
# Every secret can also be provided as <NAME>_FILE=/path/to/file (docker secret style).

# --- service -----------------------------------------------------------------
PORT=8080
DATA_DIR=./data
LOG_LEVEL=info
# Long random string. Required for POST /admin/refresh; when missing the endpoint is disabled.
ADMIN_TOKEN=replace-with-a-long-random-token

# --- collection ---------------------------------------------------------------
# Bangumi requires a descriptive User-Agent.
BANGUMI_UA=AirRadar/0.1.0 (+https://github.com/ModerRAS/AirRadar)
# Optional override for the collection season. Empty = current JST season.
SEASON_OVERRIDE=
# Collection interval in hours (fractional allowed). Jitter of +/-10% is applied.
REFRESH_HOURS=6
# Processing window per run; subjects rotate by least-recently-checked.
MAX_SUBJECTS_PER_RUN=30
INCLUDE_PLATFORMS=TV,WEB

# --- search credentials: web discovery (independent from LLM credentials) ----
# Only providers listed here (and configured with their own key) are used.
# Example: DeepSeek search only. Its key is NOT used by the LLM client.
SEARCH_PROVIDER_ORDER=deepseek
SEARCH_QUERIES_PER_SUBJECT=2
MAX_SEARCH_CALLS=60
SEARCH_FALLBACK_ON_EMPTY=false
SEARCH_TIMEOUT_SECS=20
# DeepSeek search (separate DeepSeek API key + optional endpoint/model)
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_SEARCH_MODEL=deepseek-chat
# Optional additional search providers (each uses its own key)
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- LLM credentials: extraction fallback (independent from search keys) -----
# OpenCode Go example (OpenAI-compatible):
#   LLM_BASE_URL=https://opencode.ai/inference/go/v1
#   LLM_API_KEY=<OpenCode Go subscription key>   # NOT the DeepSeek search key
#   LLM_MODEL=<model id from the OpenCode Go catalog>
# The gateway requires x-opencode-session. Leave LLM_SESSION_ID empty and
# AirRadar generates one stable id, persisted as DATA_DIR/llm-session-id.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SESSION_ID=
LLM_BATCH_SIZE=5
MAX_LLM_CALLS=10
LLM_MAX_INPUT_CHARS=1200

# --- fetching ----------------------------------------------------------------
FETCH_UA=
FETCH_TIMEOUT_SECS=15
FETCH_CONCURRENCY=4
FETCH_MIN_INTERVAL_MS=300
FETCH_MAX_BYTES=204800
FETCH_PAGES_PER_SUBJECT=3
ENABLE_OFFICIAL_SITE=true

# --- storage caps ------------------------------------------------------------
CACHE_DIR=
CACHE_MAX_BYTES=268435456
CACHE_TTL_HOURS=72
HISTORY_KEEP=10
STATE_RETENTION_SEASONS=4

# --- data quality ------------------------------------------------------------
# false = only high-confidence rows are published; medium goes to the review queue.
PUBLISH_MEDIUM=true
MAX_CANDIDATES_PER_SUBJECT=40
